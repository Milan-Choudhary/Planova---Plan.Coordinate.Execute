# Planova AI environment template.
#   cp .env.example .env     then replace every CHANGE_ME value.
# `.env` is git-ignored: never commit it. This example holds placeholders only.
#
# Who reads this file:
#   * docker-compose.yml  - via ${VAR} references
#   * backend (Spring)    - application.yml imports ../.env and references the same names
#   * frontend (Vite)     - only variables starting with VITE_ are exposed to the browser

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=planova
POSTGRES_USER=planova
POSTGRES_PASSWORD=CHANGE_ME
# Port published on YOUR machine (the container always listens on 5432 internally).
POSTGRES_HOST_PORT=5432

# ---- Backend -----------------------------------------------------------------
BACKEND_PORT=8080
# `dev` enables demo-user seeding. Use anything else (e.g. `prod`) to disable it.
SPRING_PROFILES_ACTIVE=dev
# HMAC key used to sign login tokens. >= 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_AT_LEAST_32_CHARS
JWT_EXPIRY_MINUTES=60
# Set to false to switch off background jobs (escalation, recovery, notification retry).
SCHEDULER_ENABLED=true
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Password given to the demo users created in the `dev` profile (see SETUP.md). Must be >= 12 chars.
SEED_PASSWORD=CHANGE_ME_DEMO_PASSWORD

# ---- Frontend ----------------------------------------------------------------
FRONTEND_PORT=3000
# Public (NOT secret) - where the browser finds the API when you run `npm run dev`.
VITE_API_BASE_URL=http://localhost:8080
